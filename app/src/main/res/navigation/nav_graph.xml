<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="br.com.zamfir.comprarei.feature.cart.presentation.HomeFragment"
        android:label="fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_productsFragment"
            app:destination="@id/productsFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right"
            app:popUpTo="@id/homeFragment" />
        <action
            android:id="@+id/action_homeFragment_to_categoryFragment"
            app:destination="@id/categoryFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right" />
        <action
            android:id="@+id/action_homeFragment_to_configuracaoFragment"
            app:destination="@id/configuracaoFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/productsFragment"
        android:name="br.com.zamfir.comprarei.feature.product.presentation.ProductsFragment"
        android:label="fragment_products">
        <argument
            android:name="cartName"
            app:argType="string" />
        <argument
            android:name="cartId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/categoryFragment"
        android:name="br.com.zamfir.comprarei.feature.category.presentation.CategoryFragment"
        android:label="CategoryFragment" />
    <fragment
        android:id="@+id/configuracaoFragment"
        android:name="br.com.zamfir.comprarei.feature.settings.presentation.ConfigurationFragment"
        android:label="ConfiguracaoFragment">
        <action
            android:id="@+id/action_configuracaoFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"/>
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="br.com.zamfir.comprarei.feature.profile.presentation.ProfileFragment"
        android:label="ProfileFragment"/>
</navigation>