<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".app.MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_comprarei"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_comprarei_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Starting">
        <activity
            android:name=".feature.crash.CrashActivity"
            android:exported="true"
            android:theme="@style/Theme.Comprarei"/>
        <activity
            android:name=".feature.auth.presentation.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Comprarei"/>
        <activity
            android:name=".feature.auth.presentation.DeleteAccountActivity"
            android:exported="true"
            android:theme="@style/Theme.Comprarei"/>
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Starting"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>